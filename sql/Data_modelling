CREATE OR REPLACE VIEW AUCKLAND_HOUSING.RAW_DATA.VW_SUBURB_SALES_VS_RENTAL AS
SELECT
    s.SUBURB,
    s.MONTH,
    s.AVG_SALES_PRICE,
    r.AVG_RENT_PRICE,
    m.REGION
FROM AUCKLAND_HOUSING.RAW_DATA.AVG_SALES_PRICE s
JOIN AUCKLAND_HOUSING.RAW_DATA.RENTAL_AVG_DATA r
    ON s.SUBURB = r.SUBURB AND s.MONTH = r.MONTH
JOIN AUCKLAND_HOUSING.RAW_DATA.SUBURB_MAPPING_TABLE m
    ON s.SUBURB = m.SUBURB;

CREATE OR REPLACE VIEW AUCKLAND_HOUSING.RAW_DATA.VW_REGION_HOUSING_METRICS AS
SELECT
    sp.MONTH, sp.YEAR, sp.REGION,
    sp.ZERO_BEDROOM AS SALES_PRICE_0BR,
    sp.ONE_BEDROOM AS SALES_PRICE_1BR,
    sp.TWO_BEDROOM AS SALES_PRICE_2BR,
    sp.THREE_BEDROOM AS SALES_PRICE_3BR,
    sp.FOUR_BEDROOM AS SALES_PRICE_4BR,
    sp.FIVE_PLUS_BEDROOM AS SALES_PRICE_5BR,
    sv.ZERO_BEDROOM AS SALES_VOL_0BR,
    sv.ONE_BEDROOM AS SALES_VOL_1BR,
    sv.TWO_BEDROOM AS SALES_VOL_2BR,
    sv.THREE_BEDROOM AS SALES_VOL_3BR,
    sv.FOUR_BEDROOM AS SALES_VOL_4BR,
    sv.FIVE_PLUS_BEDROOM AS SALES_VOL_5BR,
    rp.ONE_BEDROOM AS RENTAL_PRICE_1BR,
    rp.TWO_BEDROOM AS RENTAL_PRICE_2BR,
    rp.THREE_BEDROOM AS RENTAL_PRICE_3BR,
    rp.FOUR_BEDROOM AS RENTAL_PRICE_4BR,
    rp.FIVE_PLUS_BEDROOM AS RENTAL_PRICE_5BR,
    rv.ONE_BEDROOM AS RENTAL_VOL_1BR,
    rv.TWO_BEDROOM AS RENTAL_VOL_2BR,
    rv.THREE_BEDROOM AS RENTAL_VOL_3BR,
    rv.FOUR_BEDROOM AS RENTAL_VOL_4BR,
    rv.FIVE_PLUS_BEDROOM AS RENTAL_VOL_5BR
FROM AUCKLAND_HOUSING.RAW_DATA.AVERAGE_SALES_PRICE_NEW_CLEANED sp
LEFT JOIN AUCKLAND_HOUSING.RAW_DATA.SALES_VOLUME_AUCKLAND_RAW sv
    ON sp.MONTH = sv.MONTH AND sp.YEAR = sv.YEAR AND sp.REGION = sv.REGION
LEFT JOIN AUCKLAND_HOUSING.RAW_DATA.RENTAL_BY_PRICE_AUCKLAND_RAW rp
    ON sp.MONTH = rp.MONTH AND sp.YEAR = rp.YEAR AND sp.REGION = rp.REGION
LEFT JOIN AUCKLAND_HOUSING.RAW_DATA.RENTAL_BY_VOLUME_AUCKLAND_RAW rv
    ON sp.MONTH = rv.MONTH AND sp.YEAR = rv.YEAR AND sp.REGION = rv.REGION;

CREATE OR REPLACE VIEW AUCKLAND_HOUSING.RAW_DATA.VW_REGION_AVG_PRICES AS
SELECT
    m.REGION,
    s.MONTH AS MONTH_CODE,
    CAST(LEFT(s.MONTH, 4) AS NUMBER) AS YEAR,
    CASE RIGHT(s.MONTH, 2)
        WHEN '01' THEN 'January'
        WHEN '02' THEN 'February'
        WHEN '03' THEN 'March'
        WHEN '04' THEN 'April'
        WHEN '05' THEN 'May'
        WHEN '06' THEN 'June'
        WHEN '07' THEN 'July'
        WHEN '08' THEN 'August'
        WHEN '09' THEN 'September'
        WHEN '10' THEN 'October'
        WHEN '11' THEN 'November'
        WHEN '12' THEN 'December'
    END AS MONTH,
    ROUND(AVG(s.AVG_SALES_PRICE), 0) AS AVG_SALES_PRICE,
    ROUND(AVG(r.AVG_RENT_PRICE), 0) AS AVG_RENT_PRICE,
    COUNT(DISTINCT s.SUBURB) AS SUBURB_COUNT
FROM AUCKLAND_HOUSING.RAW_DATA.AVG_SALES_PRICE s
JOIN AUCKLAND_HOUSING.RAW_DATA.RENTAL_AVG_DATA r
    ON s.SUBURB = r.SUBURB AND s.MONTH = r.MONTH
JOIN AUCKLAND_HOUSING.RAW_DATA.SUBURB_MAPPING_TABLE m
    ON s.SUBURB = m.SUBURB
GROUP BY m.REGION, s.MONTH;

